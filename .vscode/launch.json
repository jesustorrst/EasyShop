{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Catalog API",
      "type": "coreclr",
      "request": "launch",
      "command": "watch",
      "args": ["run"],
      "program": "${workspaceFolder}/src/Services/Catalog/EasyShop.Catalog.API/bin/Debug/net10.0/EasyShop.Catalog.API",
      "cwd": "${workspaceFolder}/src/Services/Catalog/EasyShop.Catalog.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Debug Identity API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Services/Identity/EasyShop.Identity.API/bin/Debug/net10.0/EasyShop.Identity.API",
      "args": [],
      "cwd": "${workspaceFolder}/src/Services/Identity/EasyShop.Identity.API"
    },
    {
      "name": "Launch Azure Function (Catalog)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Services/Catalog/EasyShop.Catalog.Functions/bin/Debug/net10.0/EasyShop.Catalog.Functions.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Services/Catalog/EasyShop.Catalog.Functions",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Attach to .NET Functions",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:azureFunctions.pickProcess}"
    }
  ]
}
